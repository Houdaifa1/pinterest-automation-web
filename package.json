{
  "name": "pinterest-automations-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --port 8788",
    "build": "node scripts/build-engine.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:engine": "cd engine && python3 tools/build.py && node --test tests/engine.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pinterest-automations"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2",
    "@cloudflare/vitest-plugin": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
