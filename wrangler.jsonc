{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinterest-automations",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinterest-automations",
      "database_id": "8e90fb5d-e8c1-40a0-a2bd-67eb25b5aee5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://automation.houdaifa.dev",
    "OWNER_EMAIL": "houdaifadrahm@gmail.com"
  }
}
